# Бос болса, кездейсоқ кілт instance/session.key ішінде жасалады.
SECRET_KEY=
# Алғашқы іске қосуда көрсетілген құпиясөз немесе instance/admin-password.txt
# ADMIN_PASSWORD=
HOST=127.0.0.1
PORT=5000
MAX_UPLOAD_MB=200
MAX_VIDEO_SECONDS=180
SAMPLE_SECONDS=1.0
# Бастапқы шек; жергілікті деректерде оңтайлылығы расталмаған.
MODEL_CONFIDENCE=0.60
# Қатар іріктелген кадрдағы бір санат + IoU сәйкестігі; 1 сүзгіні өшіреді.
TEMPORAL_MIN_HITS=2
TEMPORAL_IOU=0.20
MODEL_DEVICE=cpu
MODEL_REPO=dronefreak/rdd2022-yolov8n
MODEL_REVISION=acf216a43d796f7910fc854f662c1e9cfa03fc01
MODEL_FILENAME=best.pt
# Тек HTTPS арқылы орналастырғанда true
COOKIE_SECURE=false
PUBLIC_BASE_URL=http://127.0.0.1:5000
